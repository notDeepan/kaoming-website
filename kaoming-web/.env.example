# Public origin used for canonical URLs, hreflang alternates and OG images.
# Leave unset locally; set it on the deploy target.
NEXT_PUBLIC_SITE_URL=

# Search engines are blocked unless this is exactly "true".
# Do not switch on until KAO MING approves the redesign (Appendix 2 — hosting).
NEXT_PUBLIC_ALLOW_INDEXING=false

# RFQ lead store. SQLite for the pilot; a Postgres URL when hosted.
DATABASE_URL="file:./dev.db"

# Where RFQ notifications go. Comma-separated. Until sales confirms the inbox
# (Appendix 2), leave this unset — the API still stores the lead and logs the
# notification it could not send, rather than dropping it silently.
RFQ_NOTIFY_TO=
RFQ_NOTIFY_FROM=

# Resend API key. Unset means no mail is sent; nothing else changes.
RESEND_API_KEY=

# Uploaded drawings, resolved from the project root. Must stay outside public/.
RFQ_UPLOAD_DIR=.uploads

# GA4 measurement ID. Unset means analytics no-ops and logs in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# RFQ abuse controls. Defaults to 5 submissions per 10 minutes per client.
RFQ_RATE_MAX=
RFQ_RATE_WINDOW_MS=
